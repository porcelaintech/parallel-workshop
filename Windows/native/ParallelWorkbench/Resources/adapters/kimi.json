{
  "id": "kimi",
  "name": "Kimi",
  "origin": "https://www.kimi.com/",
  "input": {
    "selectors": [
      "div.chat-input-editor[contenteditable='true']",
      ".chat-input-editor [contenteditable='true']",
      ".chat-input-editor textarea",
      "[contenteditable='true']",
      "textarea"
    ]
  },
  "send": {
    "type": "button",
    "selectors": [
      "div.send-button-container",
      ".send-button-container",
      "button[aria-label*='发送']",
      "button[aria-label*='Send']"
    ]
  },
  "probe": {
    "loggedOut": [
      "xpath://span[contains(@class,'user-name') and contains(text(),'Log in')]",
      "xpath://*[contains(text(),'Phone number login')]"
    ],
    "loginModal": [
      "xpath://*[contains(@class,'login') and contains(@class,'modal')]",
      "xpath://*[contains(@class,'ant-modal') and contains(text(),'Log in')]"
    ],
    "challenge": [
      "#challenge-stage",
      "iframe[title*='challenge' i]",
      "iframe[title*='验证' i]"
    ]
  },
  "international": false,
  "homeHosts": [
    "www.kimi.com",
    "kimi.moonshot.cn"
  ],
  "attachment": {
    "selectors": [
      "input.hidden-input"
    ],
    "openSelectors": [
      ".toolkit-trigger-btn"
    ]
  }
}