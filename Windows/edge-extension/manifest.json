{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "智囊 · Braintrust",
  "version": "0.4.1",
  "description": "智囊 Braintrust：一个问题，多位 AI 同时思考。支持 ChatGPT、DeepSeek、豆包、Kimi、通义千问与文心一言。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://www.tongyi.com/*",
    "https://www.qianwen.com/*",
    "https://yiyan.baidu.com/*",
    "https://chatgpt.com/*",
    "https://wenxin.baidu.com/*",
    "https://open.weixin.qq.com/*",
    "https://passport.baidu.com/*",
    "https://appleid.apple.com/*",
    "https://auth.openai.com/*",
    "https://chat.openai.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.moonshot.cn/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none';"
  },
  "action": {
    "default_title": "打开智囊",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.moonshot.cn/*",
        "https://www.tongyi.com/*",
        "https://www.qianwen.com/*",
        "https://yiyan.baidu.com/*",
        "https://wenxin.baidu.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://auth.openai.com/*",
        "https://open.weixin.qq.com/*",
        "https://passport.baidu.com/*",
        "https://appleid.apple.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.weixin.qq.com/*"
      ],
      "js": [
        "auth-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "lib/model-preference.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "workbench.html",
        "workbench.js",
        "workbench.css",
        "launch.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
